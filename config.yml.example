autoreply:
  # 自动关键词回复，你可以复制成多行，每个关键词用 `|` 隔开即可，在 `:` 后输入自动回复内容
  "在吗|你好": "请说明您的问题，客服会在第一时间回复您"
  "导入不|下载资料|更新不|显示错误": "请登录网站，确认套餐未过期，换个wifi后，按教程最后一步点击“一键导入”重新导入线路"
  "连接不上|无法连接|没网": "请参考网站教程重新操作，并执行连通性测试确认节点是否正常"
  "gpt|GPT": "无法使用 ChatGPT，请选择台湾或韩国节点（香港节点不支持），重启 app 或浏览器，并开启全局模式。"
  "抖音|tiktok": "请安装海外版本 TikTok，线路要求不高，使用方法请自行搜索"
  "锁定|登不上|id|密码不对": "请使用备用账号登录：	https://aocad.sha.cx/73c10f2c775dd96e7911c410121608ac"
  "卡|稳定|超时|频繁": "【兔子冲浪】
                https://www.bnsrf.com
                亲，请前往新站注册并下载最新版客户端，
                连接成功后联系客服转移套餐。
                新站采用全新加密技术，速度更快、连接更稳！"
  "全局": "请根据设备操作客户端设置全局模式：
            苹果：Shadowrocket -> 全局路由 -> 选择代理模式。
            安卓：Clash -> 连接 -> 代理 -> 全局模式 -> 选择海外节点。
            电脑：Clash -> 代理 -> 全局 -> 选择海外节点。"
  "注册不|怎么注册|无法注册": "可访问新站注册，新用户可免费体验一小时：https://www.bnsrf.com"
  "密码忘了|重置密码": "请在客服留言注册邮箱及新密码，工作人员将在 12 小时内处理"
  "试用|免费": "本站为付费服务，请购买套餐后按网站教程连接"
  "怎么购买|续费|怎么付款": "请登录官网首页购买套餐并付款即可"
  "如何使用|下载软件|加速器下载|添加节点": "注册后登录官网购买套餐，按首页教程连接即可访问外网"
  "邮箱不存在": "统会定期删除过期用户，重新注册即可"


openai:
  # APIKey
  apiKey: 
  # 预制内容，内容越多token消耗越多，单价越贵
  payload: |
    作为简体中文客服，请始终以温柔、耐心的态度回复所有消息，确保每次交互中用户感受到尊重和理解。
    请仅使用纯文本回复，不得使用其他语言或格式化语法。
    积极倾听用户的问题，耐心询问细节，并提供清晰、详细的回答或指导。
    优先参考提供的内容，以提供准确解答；若知识库无相关信息，再深入思考找到适合的回答。
    在每次互动中，确保为用户提供友好、积极的支持体验。
